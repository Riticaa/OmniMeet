# Backend Gateway Environment Settings (Small-Meeting Prototype)
# In-memory session data is held for active rooms and cleared upon process restart.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=20
TRANSLATION_PROVIDER=argos
ARGOS_AUTO_INSTALL_MODELS=true
ARGOS_CHUNK_TYPE=MINISBD
ARGOS_DEVICE_TYPE=cpu
ARGOS_COMPUTE_TYPE=int8
ENABLE_LOCAL_ASR=true
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
