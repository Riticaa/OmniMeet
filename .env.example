# ==============================================================================
# OmniMeet AI — Environment Configuration Template
# ==============================================================================

# Server Network & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional public HTTPS origin for invite links. Render uses RENDER_EXTERNAL_URL if unset.
PUBLIC_APP_URL=

# SQLite Persistence
# Path where meeting rooms, transcripts, chat, and action items are stored
SQLITE_DB_PATH=omnimeet.db

# Google Gemini API Key for OmniCopilot
# Required for grounded meeting intelligence, summaries, and Q&A.
# If omitted, OmniMeet automatically falls back to its offline grounded search engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=20

# Google Cloud Translation Basic API key (optional, server-side only).
# Enable Cloud Translation and billing for the Google Cloud project before use.
# Keep this key in .env / Render secrets; never expose it in frontend code.
GOOGLE_TRANSLATE_API_KEY=

# Media Transport: LiveKit SFU Configuration (Optional for SFU mode)
# For deployment, configure a public LiveKit Cloud (or equivalent) project. A local
# LiveKit container URL is only reachable during local Docker Compose development.
# Without these values OmniMeet falls back to WebRTC P2P Mesh.
MEDIA_TRANSPORT_MODE=mesh
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# WebRTC STUN / TURN Configuration
# Used for NAT traversal in P2P mesh and SFU connectivity
STUN_SERVER_1=stun:stun.l.google.com:19302
STUN_SERVER_2=stun:stun1.l.google.com:19302
# Optional TURN server credentials (do NOT commit secrets)
# TURN_SERVER_URL=turn:turn.example.com:3478
# TURN_USERNAME=turnuser
# TURN_CREDENTIAL=turnsecret

# Speech AI Settings (Edge Faster-Whisper Pipeline)
WHISPER_MODEL_SIZE=base
ENABLE_LOCAL_ASR=true
INFERENCE_DEVICE=cpu
COMPUTE_TYPE=int8

